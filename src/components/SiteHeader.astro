---
const pathname = Astro.url.pathname;

const navItems = [
	{ label: "Home", href: "/" },
	{ label: "Projects", href: "/projects" },
	{ label: "Experience", href: "/experience" },
	{ label: "Contact", href: "/contact" },
];

const isActive = (href: string) =>
	href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
	<a class="site-mark" href="/" aria-label="Ali Bonagdaran home">
		<span>Ali Bonagdaran</span>
	</a>
	<div class="site-header-tools">
		<nav class="site-nav" aria-label="Primary navigation">
			{
				navItems.map((item) => (
					<a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="theme-selector" role="group" aria-label="Color theme">
			<button
				type="button"
				class="theme-option"
				data-theme-choice="dark"
				aria-label="Use dark theme"
				aria-pressed="true"
			>
				<svg class="theme-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
					<path d="M13.3 10.4A5.9 5.9 0 0 1 5.6 2.7 5.9 5.9 0 1 0 13.3 10.4Z" />
				</svg>
				<span>Dark</span>
			</button>
			<button
				type="button"
				class="theme-option"
				data-theme-choice="light"
				aria-label="Use light theme"
				aria-pressed="false"
			>
				<svg class="theme-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
					<circle cx="8" cy="8" r="2.8" />
					<path d="M8 1.2v1.4m0 10.8v1.4M1.2 8h1.4m10.8 0h1.4M3.2 3.2l1 1m7.6 7.6 1 1m0-9.6-1 1m-7.6 7.6-1 1" />
				</svg>
				<span>Light</span>
			</button>
		</div>
	</div>
</header>

<script>
	const themeOptions = document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]");
	const themeColorMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
	const themeStorageKey = "ali-portfolio-theme";

	function setTheme(theme: "dark" | "light", shouldPersist = false) {
		const root = document.documentElement;
		root.dataset.theme = theme;

		for (const option of themeOptions) {
			option.setAttribute("aria-pressed", String(option.dataset.themeChoice === theme));
		}

		if (themeColorMeta) {
			themeColorMeta.content = getComputedStyle(root).backgroundColor;
		}

		if (shouldPersist) {
			try {
				window.localStorage.setItem(themeStorageKey, theme);
			} catch {
				// The selected theme still applies for this page if storage is unavailable.
			}
		}
	}

	for (const option of themeOptions) {
		option.addEventListener("click", () => {
			const theme = option.dataset.themeChoice;
			if (theme === "dark" || theme === "light") setTheme(theme, true);
		});
	}

	setTheme(document.documentElement.dataset.theme === "light" ? "light" : "dark");
</script>
