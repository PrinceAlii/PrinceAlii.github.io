---
import type { CollectionEntry } from "astro:content";

type Props = {
	project: CollectionEntry<"projects">;
	index: number;
};

const { project, index } = Astro.props;
const slug = project.id.replace(/\.(md|mdx)$/, "");
const titleId = `project-${slug.replace(/[^a-z0-9]+/gi, "-")}`;
---

<article class="project-entry" aria-labelledby={titleId}>
	<div class="entry-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
	<div class="project-entry-main">
		<div class="project-entry-heading">
			<h2 id={titleId}><a href={`/projects/${slug}`}>{project.data.title}</a></h2>
			<p class="project-stack">{project.data.techStack.join(" · ")}</p>
		</div>
		<p class="project-entry-description">{project.data.description}</p>
		<div class="inline-links">
			<a href={`/projects/${slug}`}>Read case study</a>
			{
				project.data.liveLink && (
					<a class="inline-link--external" href={project.data.liveLink} target="_blank" rel="noopener noreferrer">
						<span class="link-label">Live</span> <span class="external-mark" aria-hidden="true">↗</span>
					</a>
				)
			}
			{
				project.data.githubLink && (
					<a class="inline-link--external" href={project.data.githubLink} target="_blank" rel="noopener noreferrer">
						<span class="link-label">Source</span> <span class="external-mark" aria-hidden="true">↗</span>
					</a>
				)
			}
		</div>
	</div>
</article>
