---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

type Props = {
	entry: CollectionEntry<"experience">;
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const isCurrent = entry.data.endDate === "Present";

const dateFormat = new Intl.DateTimeFormat("en-AU", {
	month: "short",
	year: "numeric",
});

const formatDate = (date: Date | "Present") => (date === "Present" ? date : dateFormat.format(date));
const titleId = `experience-${entry.id.replace(/[^a-z0-9]+/gi, "-")}`;
---

<article class:list={["experience-entry", isCurrent && "is-current"]} aria-labelledby={titleId}>
	<div class="experience-dates">
		{isCurrent && <span class="entry-status">Current role</span>}
		<p>{formatDate(entry.data.startDate)} to {formatDate(entry.data.endDate)}</p>
		<p>{entry.data.location}</p>
	</div>
	<div class="experience-entry-main">
		<div class="experience-heading">
			<h2 id={titleId}>{entry.data.title}</h2>
			<p class="experience-company">{entry.data.company}</p>
		</div>
		<div class="prose">
			<Content />
		</div>
		{
			entry.data.skills.length > 0 && (
				<ul class="experience-skills" aria-label={`${entry.data.title} areas of work`}>
					{entry.data.skills.map((skill) => <li>{skill}</li>)}
				</ul>
			)
		}
	</div>
</article>
