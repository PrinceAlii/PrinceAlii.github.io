---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Contact"
	description="Ways to reach Ali Bonagdaran."
>
	<header class="page-head">
		<h1>Contact</h1>
	</header>

	<section class="contact-page">
		<div class="contact-item">
			<p class="meta">Email</p>
			<a href="mailto:alibonagdaran@gmail.com" class="text-link">alibonagdaran@gmail.com</a>
		</div>
		<div class="contact-item">
			<p class="meta">LinkedIn</p>
			<a href="https://www.linkedin.com/in/alibonagdaran/" target="_blank" rel="noopener noreferrer" class="text-link">linkedin.com/in/alibonagdaran</a>
		</div>
		<div class="contact-item">
			<p class="meta">GitHub</p>
			<a href="https://github.com/PrinceAlii" target="_blank" rel="noopener noreferrer" class="text-link">github.com/PrinceAlii</a>
		</div>
		<div class="contact-item">
			<p class="meta">Resume</p>
			<a href="/resume.pdf" class="text-link">Download resume (PDF)</a>
		</div>
	</section>
</BaseLayout>
