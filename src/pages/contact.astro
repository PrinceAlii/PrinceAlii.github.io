---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Direct ways to reach Ali Bonagdaran.">
	<header class="page-intro page-intro--single">
		<h1>Contact</h1>
	</header>

	<nav class="contact-directory" aria-label="Contact options">
		<a class="contact-entry" href="mailto:alibonagdaran@gmail.com">
			<span class="contact-index" aria-hidden="true">01</span>
			<span class="contact-type">Email</span>
			<span class="contact-value">alibonagdaran@gmail.com</span>
		</a>
		<a class="contact-entry" href="https://www.alibo.dev" target="_blank" rel="noopener noreferrer">
			<span class="contact-index" aria-hidden="true">02</span>
			<span class="contact-type">Website</span>
			<span class="contact-value"><span class="link-label">alibo.dev</span> <span class="external-mark" aria-hidden="true">↗</span></span>
		</a>
		<a class="contact-entry" href="https://www.linkedin.com/in/alibonagdaran/" target="_blank" rel="noopener noreferrer">
			<span class="contact-index" aria-hidden="true">03</span>
			<span class="contact-type">LinkedIn</span>
			<span class="contact-value"><span class="link-label">linkedin.com/in/alibonagdaran</span> <span class="external-mark" aria-hidden="true">↗</span></span>
		</a>
		<a class="contact-entry" href="https://github.com/PrinceAlii" target="_blank" rel="noopener noreferrer">
			<span class="contact-index" aria-hidden="true">04</span>
			<span class="contact-type">GitHub</span>
			<span class="contact-value"><span class="link-label">github.com/PrinceAlii</span> <span class="external-mark" aria-hidden="true">↗</span></span>
		</a>
		<a class="contact-entry" href="/resume.pdf">
			<span class="contact-index" aria-hidden="true">05</span>
			<span class="contact-type">Resume</span>
			<span class="contact-value"><span class="link-label">Download PDF</span> <span class="external-mark" aria-hidden="true">↗</span></span>
		</a>
	</nav>
</BaseLayout>
