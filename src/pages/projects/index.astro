---
import { getCollection } from "astro:content";
import ProjectSummary from "../../components/ProjectSummary.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => {
	const featured = Number(b.data.featured) - Number(a.data.featured);
	return featured || a.data.title.localeCompare(b.data.title);
});
---

<BaseLayout
	title="Projects"
	description="Projects and case studies by Ali Bonagdaran."
>
	<header class="page-intro">
		<h1>Projects</h1>
	</header>

	<section class="project-list" aria-label="Projects">
		{projects.map((project, index) => <ProjectSummary project={project} index={index} />)}
	</section>
</BaseLayout>
