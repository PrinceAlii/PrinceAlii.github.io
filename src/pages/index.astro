---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";

const experience = (await getCollection("experience")).sort(
	(a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);
const formatYearRange = (entry: (typeof experience)[number]) =>
	`${entry.data.startDate.getFullYear()} to ${entry.data.endDate === "Present" ? "Present" : entry.data.endDate.getFullYear()}`;
---

<BaseLayout title="Home">
	<section class="home-hero" aria-labelledby="home-title">
		<div class="hero-copy">
			<h1 id="home-title">Ali Bonagdaran</h1>
			<p class="hero-role">Graduate DevOps Engineer at the Australian Bureau of Statistics.</p>
			<p class="hero-standfirst">
				I support cloud platforms and developer tooling at the Australian Bureau of Statistics.
			</p>
			<nav class="hero-actions" aria-label="Links">
				<a class="text-link" href="/resume.pdf"><span class="link-label">Open resume</span> <span class="external-mark" aria-hidden="true">↗</span></a>
				<a class="text-link" href="/contact">Contact Me</a>
			</nav>
		</div>
	</section>

	<section class="section" aria-labelledby="work-history-title">
		<header class="section-header">
			<h2 id="work-history-title">Work history</h2>
		</header>
		<div class="experience-index">
			{
				experience.map((entry) => (
					<div class="experience-index-entry">
						<p>{formatYearRange(entry)}</p>
						<p>{entry.data.title}, {entry.data.company}</p>
					</div>
				))
			}
		</div>
		<a class="text-link" href="/experience">View experience</a>
	</section>

	<section class="home-close" aria-labelledby="home-close-title">
		<h2 id="home-close-title">Contact</h2>
		<div class="home-close-copy">
			<p><a class="text-link" href="mailto:alibonagdaran@gmail.com">alibonagdaran@gmail.com</a></p>
			<SocialLinks />
			<div class="inline-links">
				<a class="text-link" href="/contact">All contact details</a>
				<a class="text-link" href="/resume.pdf"><span class="link-label">Resume</span> <span class="external-mark" aria-hidden="true">↗</span></a>
			</div>
		</div>
	</section>
</BaseLayout>
